# T051 canonical real-tokenized files remain on the 5090 for release QA.
# Git carries the bounded JSONL inventory under git_shards/ instead.
/HallucinationDataset/tokenized/chemdfm_r/train.jsonl
/HallucinationDataset/tokenized/chemdfm_r/validation.jsonl
/HallucinationDataset/tokenized/chemdfm_r/test.jsonl

# T051 resid_post tensors are server-side binary research artifacts.
# Their JSON sidecars and manifest remain eligible for Git.
/HallucinationDataset/activations/chemdfm_r/layer_26/**/*.pt
/HallucinationDataset/activations/chemdfm_r/layer_26/**/*.pt.partial

# Durable local job metadata is operational state, not a release artifact.
/runs/serverctl/molhallulens-t051-full/

# Generated Python packaging and interpreter caches.
*.egg-info/
__pycache__/
*.py[cod]

# Redacted rejection diagnostics are local operational data, not source code.
/GeneratedDataset/.poe_text_diagnostics/

# Local, isolated inference dependency environment.
/.venv-chemdfm-outcome/

# Local experiment logs and generated results.
/scripts/run_exp.log
/scripts/run_exp_result.md
/scripts/run_agent_exp.log
/scripts/run_agent_exp.pid
/scripts/agent_corruption_result.md
/scripts/run_edit_order_exp.log
/scripts/run_edit_order_exp.pid
/scripts/run_named_binding_exp.log
/scripts/run_named_binding_exp.pid
/scripts/run_anchored_connection_exp.log
/scripts/run_anchored_connection_exp.pid
/scripts/run_task_intent_exp.log
/scripts/run_task_intent_exp.pid
/scripts/run_full150_exp.log
/scripts/run_full150_exp.pid
